    "!pip install -q torch torchvision diffusers transformers accelerate peft datasets huggingface_hub pillow tqdm bitsandbytes"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🎨 WORKFLOW A: Stage 1 — Train Craft Knowledge & Multi-View LoRA\n",
    "Teaches the model authentic craft aesthetics (`Chikankari`, `Kalamkari`, `Phulkari`, `Ajrakh`, `Bandhani`, etc.) and multi-view generation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "HF_DATASET_REPO = \"your-username/induscraft-dataset\"  # Replace with your HF Dataset Repo\n",
    "BASE_MODEL = \"stabilityai/stable-diffusion-xl-base-1.0\"\n",
    "STAGE1_OUTPUT_DIR = \"./induscraft_stage1_craft_lora\"\n",
    "\n",
    "# Launch Stage 1 Training\n",
    "cmd_stage1 = f\"\"\"python scripts/train_sdxl_lora.py \\\n",
    "    --pretrained-model \"{BASE_MODEL}\" \\\n",
    "    --dataset-name \"{HF_DATASET_REPO}\" \\\n",
    "    --output-dir \"{STAGE1_OUTPUT_DIR}\" \\\n",
    "    --resolution 768 \\\n",
    "    --train-batch-size 2 \\\n",
    "    --num-train-epochs 10 \\\n",
    "    --learning-rate 1e-4 \\\n",
    "    --lora-rank 32 \\\n",
    "    --gradient-accumulation-steps 4 \\\n",
    "    --mixed-precision \"fp16\"\n",
    "\"\"\"\n",
    "\n",
    "print(\"Stage 1 Training Command:\")\n",
    "print(cmd_stage1)\n",
    "# !{cmd_stage1}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🧥 WORKFLOW B: Stage 2 — Train Regional Garment Inpainting LoRA\n",
    "Teaches targeted regional editing (Collar, Sleeves, Cuffs, Hemline, Chest) while strictly preserving the student's original garment silhouette."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "INPAINT_MODEL = \"diffusers/stable-diffusion-xl-1.0-inpainting-0.1\"\n",
    "STAGE2_OUTPUT_DIR = \"./induscraft_stage2_inpainting_lora\"\n",
    "\n",
    "# Launch Stage 2 Training\n",
    "cmd_stage2 = f\"\"\"python scripts/train_sdxl_inpainting_lora.py \\\n",
    "    --pretrained-model \"{INPAINT_MODEL}\" \\\n",
    "    --dataset-name \"{HF_DATASET_REPO}\" \\\n",
    "    --output-dir \"{STAGE2_OUTPUT_DIR}\" \\\n",
    "    --resolution 768 \\\n",
    "    --train-batch-size 2 \\\n",
    "    --num-train-epochs 10 \\\n",
    "    --learning-rate 1e-4 \\\n",
    "    --lora-rank 32 \\\n",
    "    --gradient-accumulation-steps 4 \\\n",
    "    --mixed-precision \"fp16\"\n",
    "\"\"\"\n",
    "\n",
    "print(\"Stage 2 Inpainting Training Command:\")\n",
    "print(cmd_stage2)\n",
    "# !{cmd_stage2}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🧪 4. Interactive Inference & Multi-View Validation\n",
    "Test both Workflow A (Multi-View Design Generation) and Workflow B (Regional Garment Inpainting)!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch
from diffusers import StableDiffusionXLPipeline, StableDiffusionXLInpaintPipeline
from PIL import Image

# 1. Test Workflow A (Create Design - Multi-View)
pipe_create = StableDiffusionXLPipeline.from_pretrained(BASE_MODEL, torch_dtype=torch.float16).to("cuda")
# pipe_create.load_lora_weights(f"{STAGE1_OUTPUT_DIR}/induscraft_sdxl_lora_final")

multi_view_prompts = [
    "A high resolution detailed fashion design photograph, [front view], of authentic chikankari embroidery style on a white modern kurta, Lucknowi shadow work.",
    "A high resolution detailed fashion design photograph, [detail view], macro close-up shot of chikankari floral jaali stitch texture.",
    "A high resolution detailed fashion design photograph, [pattern view], seamless repeating motif layout of authentic kalamkari tree of life print.",
    "A high resolution detailed fashion design photograph, [flat garment], technical flat layout of a paithani silk saree with zari border."
]

for idx, prompt in enumerate(multi_view_prompts):
    img = pipe_create(prompt, num_inference_steps=30).images[0]
    img.save(f"workflow_A_sample_{idx+1}.png")
print("✅ Workflow A Multi-View samples generated!")

# 2. Test Workflow B (Apply Craft to Garment via Inpainting)
pipe_inpaint = StableDiffusionXLInpaintPipeline.from_pretrained(INPAINT_MODEL, torch_dtype=torch.float16).to("cuda")
# pipe_inpaint.load_lora_weights(f"{STAGE2_OUTPUT_DIR}/induscraft_inpainting_lora_final")

# Dummy blank garment image + collar mask example
garment_img = Image.new("RGB", (768, 768), (245, 245, 245))
collar_mask = Image.new("L", (768, 768), 0)

inpaint_prompt = "Apply authentic Lucknowi chikankari embroidery on the collar and cuffs of the white garment."
inpainted_result = pipe_inpaint(prompt=inpaint_prompt, image=garment_img, mask_image=collar_mask).images[0]
inpainted_result.save("workflow_B_garment_edited.png")
print("✅ Workflow B Inpainting sample generated!")"
   ]
  }
